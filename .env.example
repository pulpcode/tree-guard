# TreeGuard 本地开发配置。复制为 .env 后执行：chmod 600 .env
# .env 已被 Git 忽略；不要提交、粘贴到聊天或用于生产密钥分发。

BAILIAN_API_KEY=
TREEGUARD_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TREEGUARD_LLM_MODEL=qwen3.6-35b-a3b

# 内网 Qwen 不使用 API Key；这里只配置受保护环境中的 /v1 地址和模型 ID。
TREEGUARD_QWEN_BASE_URL=
TREEGUARD_QWEN_MODEL=qwen3.6
