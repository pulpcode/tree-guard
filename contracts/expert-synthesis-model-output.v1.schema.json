{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeguard.local/contracts/expert-synthesis-model-output.v1.schema.json",
  "title": "TreeGuard Untrusted Expert Synthesis Model Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expert_claims",
    "hypotheses",
    "uncertainties",
    "risks",
    "evidence_requests",
    "questions_for_expert"
  ],
  "properties": {
    "schema_version": {"const": "expert-synthesis-model-output.v1"},
    "expert_claims": {"$ref": "#/$defs/groundedClaimList"},
    "hypotheses": {"$ref": "#/$defs/groundedClaimList"},
    "uncertainties": {"$ref": "#/$defs/groundedClaimList"},
    "risks": {"$ref": "#/$defs/groundedClaimList"},
    "evidence_requests": {"$ref": "#/$defs/groundedClaimList"},
    "questions_for_expert": {"$ref": "#/$defs/questionList"}
  },
  "anyOf": [
    {"properties": {"expert_claims": {"minItems": 1}}},
    {"properties": {"hypotheses": {"minItems": 1}}},
    {"properties": {"uncertainties": {"minItems": 1}}},
    {"properties": {"risks": {"minItems": 1}}},
    {"properties": {"evidence_requests": {"minItems": 1}}},
    {"properties": {"questions_for_expert": {"minItems": 1}}}
  ],
  "$defs": {
    "groundedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence_refs"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[FXCT][0-9]{3}$"
          },
          "contains": {
            "type": "string",
            "pattern": "^T[0-9]{3}$"
          },
          "minContains": 1
        }
      }
    },
    "groundedClaimList": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/groundedClaim"}
    },
    "questionList": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    }
  }
}
