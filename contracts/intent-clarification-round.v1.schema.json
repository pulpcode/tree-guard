{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeguard.local/contracts/intent-clarification-round.v1.schema.json",
  "title": "TreeGuard Intent Clarification Round v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round_index",
    "initial_draft",
    "answer",
    "model_provider",
    "model_capability",
    "model_name",
    "prompt_version",
    "model_provenance_status",
    "source_request_hash",
    "source_snapshot_hash",
    "source_initial_draft_hash",
    "source_answer_hash",
    "review_status",
    "intent",
    "round_hash"
  ],
  "properties": {
    "schema_version": {"const": "intent-clarification-round.v1"},
    "round_index": {"const": 1},
    "initial_draft": {
      "$ref": "change-intent-draft.v1.schema.json"
    },
    "answer": {
      "$ref": "intent-clarification-answer.v1.schema.json"
    },
    "model_provider": {"type": "string", "minLength": 1, "maxLength": 1000},
    "model_capability": {"type": "string", "minLength": 1, "maxLength": 1000},
    "model_name": {"type": "string", "minLength": 1, "maxLength": 1000},
    "prompt_version": {"type": "string", "minLength": 1, "maxLength": 1000},
    "model_provenance_status": {"const": "UNVERIFIED_FILE_ASSERTION"},
    "source_request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_initial_draft_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_answer_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_status": {
      "enum": [
        "READY_FOR_HUMAN_REVIEW",
        "CLARIFICATION_LIMIT_REACHED"
      ]
    },
    "intent": {
      "$ref": "change-intent-model-output.v1.schema.json#/$defs/intentContent"
    },
    "round_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "intent": {
            "properties": {
              "clarification_question": {"type": "string"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_status": {"const": "CLARIFICATION_LIMIT_REACHED"}
        }
      },
      "else": {
        "properties": {
          "review_status": {"const": "READY_FOR_HUMAN_REVIEW"}
        }
      }
    }
  ]
}
