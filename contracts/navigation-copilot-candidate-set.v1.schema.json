{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeguard.local/contracts/navigation-copilot-candidate-set.v1.schema.json",
  "title": "Navigation Copilot Candidate Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm_version", "source_interpretation_hash", "source_query_hash", "source_snapshot_hash", "status", "embedding_used", "allows_addition", "max_candidates", "candidates", "candidate_set_hash"],
  "properties": {
    "schema_version": {"const": "navigation-copilot-candidate-set.v1"},
    "algorithm_version": {"const": "treeguard.navigation-copilot-soft-rerank.v1"},
    "source_interpretation_hash": {"$ref": "#/$defs/digest"},
    "source_query_hash": {"$ref": "#/$defs/digest"},
    "source_snapshot_hash": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["CANDIDATES_READY", "NO_CANDIDATES", "INSUFFICIENT_SIGNAL"]},
    "embedding_used": {"const": false},
    "allows_addition": {"const": false},
    "max_candidates": {"type": "integer", "minimum": 1, "maximum": 40},
    "candidates": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/candidate"}},
    "candidate_set_hash": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "node_id", "score"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 40},
        "node_id": {"type": "string", "minLength": 1},
        "score": {
          "type": "object", "additionalProperties": false,
          "required": ["base_total", "target_bonus", "scope_bonus", "exclusion_penalty", "total", "parent_relation"],
          "properties": {
            "base_total": {"type": "integer", "minimum": 0},
            "target_bonus": {"type": "integer", "minimum": 0},
            "scope_bonus": {"type": "integer", "minimum": 0},
            "exclusion_penalty": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0},
            "parent_relation": {"enum": ["NONE", "PROPOSED_PARENT", "DIRECT_CHILD", "SAME_BRANCH"]}
          }
        }
      }
    }
  }
}
