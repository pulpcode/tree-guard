{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeguard.local/contracts/navigation-copilot-interpretation.v1.schema.json",
  "title": "Navigation Copilot Interpretation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source_request_hash", "source_snapshot_hash", "understanding", "degradation_code", "interpretation_hash"],
  "properties": {
    "schema_version": {"const": "navigation-copilot-interpretation.v1"},
    "status": {"enum": ["MODEL_VALID", "MODEL_DEGRADED"]},
    "source_request_hash": {"$ref": "#/$defs/digest"},
    "source_snapshot_hash": {"$ref": "#/$defs/digest"},
    "understanding": {"oneOf": [{"$ref": "change-understanding.v2.schema.json"}, {"type": "null"}]},
    "degradation_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "interpretation_hash": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
