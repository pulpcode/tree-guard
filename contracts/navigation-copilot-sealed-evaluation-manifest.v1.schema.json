{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeguard.local/contracts/navigation-copilot-sealed-evaluation-manifest.v1.schema.json",
  "title": "Navigation Copilot Sealed Evaluation Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "threshold_policy_version", "evaluation_role", "function_commit", "data_commit", "tree_sha256", "scenarios_sha256", "oracle_sha256", "provider_mode", "model_name", "understanding_prompt_version", "clarification_prompt_version", "semantic_prompt_version", "endpoint_class", "scenario_refs", "repeat_scenario_refs", "main_case_count", "target_present_count", "logical_case_limit", "logical_model_stage_limit", "per_case_model_stage_limit", "wire_attempt_limit", "thresholds", "production_write_enabled", "gold_eligible", "patch_eligible", "manifest_hash"],
  "properties": {
    "schema_version": {"const": "navigation-copilot-sealed-evaluation-manifest.v1"},
    "threshold_policy_version": {"const": "treeguard.navigation-copilot-sealed-gate.v1"},
    "evaluation_role": {"const": "SEALED_FICTIONAL_QUALIFICATION"},
    "function_commit": {"$ref": "#/$defs/commit"},
    "data_commit": {"$ref": "#/$defs/commit"},
    "tree_sha256": {"$ref": "#/$defs/digest"},
    "scenarios_sha256": {"$ref": "#/$defs/digest"},
    "oracle_sha256": {"$ref": "#/$defs/digest"},
    "provider_mode": {"const": "BAILIAN_LIVE"},
    "model_name": {"$ref": "#/$defs/text"},
    "understanding_prompt_version": {"$ref": "#/$defs/text"},
    "clarification_prompt_version": {"$ref": "#/$defs/text"},
    "semantic_prompt_version": {"$ref": "#/$defs/text"},
    "endpoint_class": {"const": "OFFICIAL_BAILIAN_COMPATIBLE"},
    "scenario_refs": {"type": "array", "minItems": 48, "maxItems": 48, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "repeat_scenario_refs": {"type": "array", "minItems": 16, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "main_case_count": {"const": 48},
    "target_present_count": {"const": 42},
    "logical_case_limit": {"const": 80},
    "logical_model_stage_limit": {"const": 160},
    "per_case_model_stage_limit": {"const": 2},
    "wire_attempt_limit": {"type": "integer", "minimum": 160, "maximum": 320},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_top40_hits", "min_top8_hits", "min_nonliteral_top8_hits", "min_interference_top8_hits", "min_clarification_top8_hits", "min_required_clarification_match_count", "min_wrong_context_top8_hits", "max_absent_confident_errors", "min_highlight_precision_numerator_bps", "min_correct_highlight_count", "min_no_degradation_count", "min_joint_match_count", "max_needless_clarification_count", "max_c1_top8_loss_from_r0", "min_repeat_stable_count"],
      "properties": {
        "min_top40_hits": {"const": 38},
        "min_top8_hits": {"const": 36},
        "min_nonliteral_top8_hits": {"const": 8},
        "min_interference_top8_hits": {"const": 6},
        "min_clarification_top8_hits": {"const": 5},
        "min_required_clarification_match_count": {"const": 5},
        "min_wrong_context_top8_hits": {"const": 7},
        "max_absent_confident_errors": {"const": 0},
        "min_highlight_precision_numerator_bps": {"const": 9500},
        "min_correct_highlight_count": {"const": 21},
        "min_no_degradation_count": {"const": 44},
        "min_joint_match_count": {"const": 41},
        "max_needless_clarification_count": {"const": 4},
        "max_c1_top8_loss_from_r0": {"const": 1},
        "min_repeat_stable_count": {"const": 14}
      }
    },
    "production_write_enabled": {"const": false},
    "gold_eligible": {"const": false},
    "patch_eligible": {"const": false},
    "manifest_hash": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
