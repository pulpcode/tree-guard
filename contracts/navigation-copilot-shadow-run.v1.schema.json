{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeguard.local/contracts/navigation-copilot-shadow-run.v1.schema.json",
  "title": "Navigation Copilot Shadow Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_semantics", "contract_commit", "run_ref", "provider_mode", "participant_refs", "planned_case_count", "thresholds", "production_write_enabled", "semantic_approval", "gold_eligible", "patch_eligible", "run_hash"],
  "properties": {
    "schema_version": {"const": "navigation-copilot-shadow-run.v1"},
    "record_semantics": {"const": "OPERATIONAL_SHADOW_ONLY"},
    "contract_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "run_ref": {"type": "string", "pattern": "^SR[0-9]{4,12}$"},
    "provider_mode": {"enum": ["SIMULATOR_LIVE", "BAILIAN_LIVE", "QWEN_LIVE"]},
    "participant_refs": {"type": "array", "minItems": 3, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]{2,4}$"}},
    "planned_case_count": {"type": "integer", "minimum": 30, "maximum": 1000},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_valid_case_count", "min_participant_count", "min_safe_rate_bps", "min_top8_coverage_bps", "min_navigation_completion_bps", "max_confident_error_bps", "max_median_completion_ms"],
      "properties": {
        "min_valid_case_count": {"const": 30},
        "min_participant_count": {"const": 3},
        "min_safe_rate_bps": {"const": 10000},
        "min_top8_coverage_bps": {"const": 8000},
        "min_navigation_completion_bps": {"const": 9000},
        "max_confident_error_bps": {"const": 500},
        "max_median_completion_ms": {"const": 180000}
      }
    },
    "production_write_enabled": {"const": false},
    "semantic_approval": {"const": false},
    "gold_eligible": {"const": false},
    "patch_eligible": {"const": false},
    "run_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
