{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeguard.local/contracts/provisional-simulator-response.v1.schema.json",
  "title": "TreeGuard Provisional Contract Simulator Response v1",
  "description": "Clean-room development contract only. It is not evidence of the protected production API.",
  "oneOf": [
    {"$ref": "#/$defs/categories"},
    {"$ref": "#/$defs/resources"},
    {"$ref": "#/$defs/versions"},
    {"$ref": "#/$defs/tree"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "successEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_status",
        "status",
        "message",
        "data"
      ],
      "properties": {
        "schema_version": {"type": "string"},
        "contract_status": {"const": "PROVISIONAL_SIMULATOR_CONTRACT"},
        "status": {"const": 0},
        "message": {"const": "OK"},
        "data": {}
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "parent_id", "name", "order"],
      "properties": {
        "category_id": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"], "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "category_id",
        "name",
        "head_version",
        "head_version_record_id"
      ],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "category_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "head_version": {"type": "string", "minLength": 1},
        "head_version_record_id": {"type": "string", "minLength": 1}
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "version",
        "version_record_id",
        "description",
        "is_head"
      ],
      "properties": {
        "position": {"type": "integer", "minimum": 0},
        "version": {"type": "string", "minLength": 1},
        "version_record_id": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "is_head": {"type": "boolean"}
      }
    },
    "categories": {
      "allOf": [
        {"$ref": "#/$defs/successEnvelope"},
        {
          "properties": {
            "schema_version": {
              "const": "provisional-simulator-categories.v1"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["items", "total"],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/category"}
                },
                "total": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      ]
    },
    "resources": {
      "allOf": [
        {"$ref": "#/$defs/successEnvelope"},
        {
          "properties": {
            "schema_version": {
              "const": "provisional-simulator-resources.v1"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["items", "total"],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/resource"}
                },
                "total": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      ]
    },
    "versions": {
      "allOf": [
        {"$ref": "#/$defs/successEnvelope"},
        {
          "properties": {
            "schema_version": {
              "const": "provisional-simulator-versions.v1"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resource_id",
                "ordering",
                "items",
                "total"
              ],
              "properties": {
                "resource_id": {"type": "string", "minLength": 1},
                "ordering": {"const": "OLDEST_FIRST"},
                "items": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/version"}
                },
                "total": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      ]
    },
    "tree": {
      "allOf": [
        {"$ref": "#/$defs/successEnvelope"},
        {
          "properties": {
            "schema_version": {"const": "provisional-simulator-tree.v1"},
            "data": {
              "type": "object",
              "required": ["metadata", "map_topology"],
              "properties": {
                "metadata": {"type": "object"},
                "map_topology": {"type": "object"}
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_status",
        "status",
        "message",
        "error_code"
      ],
      "properties": {
        "schema_version": {"const": "provisional-simulator-error.v1"},
        "contract_status": {"const": "PROVISIONAL_SIMULATOR_CONTRACT"},
        "status": {"type": "integer", "minimum": 400, "maximum": 599},
        "message": {"const": "Simulator request rejected."},
        "error_code": {
          "type": "string",
          "pattern": "^SIMULATOR_[A-Z0-9_]+$"
        }
      }
    }
  }
}
