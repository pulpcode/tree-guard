{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeguard.local/contracts/scenario-preparation-batch.v1.schema.json",
  "title": "TreeGuard Scenario Preparation Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preparation_source_status",
    "review_status",
    "semantic_approval",
    "gold_eligible",
    "patch_eligible",
    "source_snapshot_hash",
    "source_profile_hash",
    "source_plan_hash",
    "status",
    "planned_unit_count",
    "attempted_unit_count",
    "completed_unit_count",
    "failed_unit_count",
    "not_executed_unit_count",
    "omitted_target_count",
    "candidates",
    "failures",
    "not_executed",
    "omitted_family_refs",
    "omitted_branch_node_ids",
    "family_outcomes",
    "branch_coverage",
    "target_stage_coverage",
    "projected_node_coverage",
    "batch_hash"
  ],
  "properties": {
    "schema_version": {"const": "scenario-preparation-batch.v1"},
    "preparation_source_status": {
      "enum": ["UNVERIFIED_MODEL_GENERATION", "FIXTURE_REPLAY"]
    },
    "review_status": {"const": "PENDING_HUMAN_REVIEW"},
    "semantic_approval": {"const": false},
    "gold_eligible": {"const": false},
    "patch_eligible": {"const": false},
    "source_snapshot_hash": {"$ref": "#/$defs/digest"},
    "source_profile_hash": {"$ref": "#/$defs/digest"},
    "source_plan_hash": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["SUCCESS", "PARTIAL", "FAILED"]},
    "planned_unit_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "attempted_unit_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "completed_unit_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "failed_unit_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "not_executed_unit_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "omitted_target_count": {"type": "integer", "minimum": 0},
    "candidates": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/batchCandidate"}
    },
    "failures": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/failure"}
    },
    "not_executed": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/notExecuted"}
    },
    "omitted_family_refs": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scenarioFamily"}
    },
    "omitted_branch_node_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "family_outcomes": {"$ref": "#/$defs/familyOutcomes"},
    "branch_coverage": {"$ref": "#/$defs/branchCoverage"},
    "target_stage_coverage": {"$ref": "#/$defs/targetStageCoverage"},
    "projected_node_coverage": {"$ref": "#/$defs/projectedNodeCoverage"},
    "batch_hash": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "internalRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "planUnitRef": {"type": "string", "pattern": "^U(?:00[1-9]|0[12][0-9]|03[0-2])$"},
    "scenarioFamily": {
      "enum": [
        "CLEAR_EXISTING_REUSE", "NEW_NODE_PLACEMENT", "HOMONYM_CLARIFICATION",
        "WRONG_PARENT_OR_CROSS_BRANCH", "KIND_CONFLICT", "CARDINALITY_CONFLICT",
        "INSUFFICIENT_EVIDENCE", "UNBOUNDED_COMBINATION"
      ]
    },
    "batchCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_ref", "plan_unit_ref", "local_scenario_ref", "source_draft_hash", "draft"],
      "properties": {
        "candidate_ref": {"type": "string", "pattern": "^C(?:00[1-9]|0[12][0-9]|03[0-2])$"},
        "plan_unit_ref": {"$ref": "#/$defs/planUnitRef"},
        "local_scenario_ref": {"const": "S001"},
        "source_draft_hash": {"$ref": "#/$defs/digest"},
        "draft": {"$ref": "scenario-preparation-candidate.v1.schema.json"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_unit_ref", "error_code"],
      "properties": {
        "plan_unit_ref": {"$ref": "#/$defs/planUnitRef"},
        "error_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}
      }
    },
    "notExecuted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_unit_ref", "reason_code"],
      "properties": {
        "plan_unit_ref": {"$ref": "#/$defs/planUnitRef"},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}
      }
    },
    "familyOutcome": {
      "enum": [
        "CANDIDATE_READY",
        "FAILED",
        "NOT_EXECUTED",
        "NOT_APPLICABLE",
        "OMITTED_BUDGET"
      ]
    },
    "familyOutcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CLEAR_EXISTING_REUSE",
        "NEW_NODE_PLACEMENT",
        "HOMONYM_CLARIFICATION",
        "WRONG_PARENT_OR_CROSS_BRANCH",
        "KIND_CONFLICT",
        "CARDINALITY_CONFLICT",
        "INSUFFICIENT_EVIDENCE",
        "UNBOUNDED_COMBINATION"
      ],
      "properties": {
        "CLEAR_EXISTING_REUSE": {"$ref": "#/$defs/familyOutcome"},
        "NEW_NODE_PLACEMENT": {"$ref": "#/$defs/familyOutcome"},
        "HOMONYM_CLARIFICATION": {"$ref": "#/$defs/familyOutcome"},
        "WRONG_PARENT_OR_CROSS_BRANCH": {"$ref": "#/$defs/familyOutcome"},
        "KIND_CONFLICT": {"$ref": "#/$defs/familyOutcome"},
        "CARDINALITY_CONFLICT": {"$ref": "#/$defs/familyOutcome"},
        "INSUFFICIENT_EVIDENCE": {"$ref": "#/$defs/familyOutcome"},
        "UNBOUNDED_COMBINATION": {"$ref": "#/$defs/familyOutcome"}
      }
    },
    "branchCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ready_branch_node_ids",
        "failed_branch_node_ids",
        "not_executed_branch_node_ids",
        "omitted_budget_branch_node_ids"
      ],
      "properties": {
        "candidate_ready_branch_node_ids": {"$ref": "#/$defs/internalRefs"},
        "failed_branch_node_ids": {"$ref": "#/$defs/internalRefs"},
        "not_executed_branch_node_ids": {"$ref": "#/$defs/internalRefs"},
        "omitted_budget_branch_node_ids": {"$ref": "#/$defs/internalRefs"}
      }
    },
    "stageCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_unit_count",
        "candidate_ready_unit_count",
        "failed_unit_count",
        "not_executed_unit_count",
        "validation_status"
      ],
      "properties": {
        "planned_unit_count": {"type": "integer", "minimum": 0, "maximum": 32},
        "candidate_ready_unit_count": {"type": "integer", "minimum": 0, "maximum": 32},
        "failed_unit_count": {"type": "integer", "minimum": 0, "maximum": 32},
        "not_executed_unit_count": {"type": "integer", "minimum": 0, "maximum": 32},
        "validation_status": {"const": "NOT_RUN"}
      }
    },
    "targetStageCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["INTENT", "RETRIEVAL", "RECOMMENDATION"],
      "properties": {
        "INTENT": {"$ref": "#/$defs/stageCoverage"},
        "RETRIEVAL": {"$ref": "#/$defs/stageCoverage"},
        "RECOMMENDATION": {"$ref": "#/$defs/stageCoverage"}
      }
    },
    "projectedNodeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_node_count",
        "included_node_count",
        "omitted_node_count",
        "coverage_complete"
      ],
      "properties": {
        "total_node_count": {"type": "integer", "minimum": 1},
        "included_node_count": {"type": "integer", "minimum": 0},
        "omitted_node_count": {"type": "integer", "minimum": 0},
        "coverage_complete": {"type": "boolean"}
      }
    }
  }
}
