{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeguard.local/contracts/tree-diagnostic-profile.v1.schema.json",
  "title": "TreeGuard Tree Diagnostic Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm_version",
    "source_snapshot_hash",
    "source_tree_id",
    "source_tree_version",
    "node_count",
    "root_count",
    "max_depth",
    "kind_counts",
    "value_type_counts",
    "cardinality_counts",
    "depth_counts",
    "top_level_branches",
    "findings",
    "profile_hash"
  ],
  "properties": {
    "schema_version": {"const": "tree-diagnostic-profile.v1"},
    "algorithm_version": {"const": "treeguard.tree-diagnostic-profile.v1"},
    "source_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_tree_id": {"type": "string", "minLength": 1},
    "source_tree_version": {"type": "string", "minLength": 1},
    "node_count": {"type": "integer", "minimum": 1},
    "root_count": {"type": "integer", "minimum": 1},
    "max_depth": {"type": "integer", "minimum": 0},
    "kind_counts": {"$ref": "#/$defs/countMap"},
    "value_type_counts": {"$ref": "#/$defs/countMap"},
    "cardinality_counts": {"$ref": "#/$defs/countMap"},
    "depth_counts": {"$ref": "#/$defs/depthCountMap"},
    "top_level_branches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/topLevelBranch"}
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/finding"}
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "countMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "depthCountMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "topLevelBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_node_id",
        "branch_node_id",
        "node_count",
        "max_relative_depth",
        "max_direct_child_count"
      ],
      "properties": {
        "root_node_id": {"type": "string", "minLength": 1},
        "branch_node_id": {"type": "string", "minLength": 1},
        "node_count": {"type": "integer", "minimum": 1},
        "max_relative_depth": {"type": "integer", "minimum": 0},
        "max_direct_child_count": {"type": "integer", "minimum": 0}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "node_ids", "occurrence_count"],
      "properties": {
        "code": {
          "enum": [
            "NAME_REUSED_ACROSS_PATHS",
            "NAME_CONTRACT_CONFLICT",
            "CHILD_CONTRACT_VECTOR_REUSED"
          ]
        },
        "node_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "occurrence_count": {"type": "integer", "minimum": 2}
      }
    }
  }
}
